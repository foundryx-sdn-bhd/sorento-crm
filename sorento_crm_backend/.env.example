# Copy to .env and replace every <set me>. Compose refuses to start without these.
POSTGRES_USER=<set me>
POSTGRES_PASSWORD=<set me>
JWT_SECRET=<set me>
# Stored-secret encryption key(s), current first, comma-separated. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Never reuse JWT_SECRET. See documentation/plans/security/PLAN-ai-key-encrypt-08oct.md.
FIELD_ENCRYPTION_KEY=<set me>
