# Copy to .env and replace every <set me>. Compose refuses to start without these.
POSTGRES_USER=<set me>
POSTGRES_PASSWORD=<set me>
JWT_SECRET=<set me>
# Stored-secret encryption key(s), current first, comma-separated. Never reuse JWT_SECRET.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=<set me>
POSTGRES_DB=sorento_crm
# AWS S3 (only when using file attachments; leave empty otherwise)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
