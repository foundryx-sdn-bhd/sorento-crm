# Node modules
sorento_crm_frontend/node_modules/*
sorento_crm_backend/node_modules/*

# Next.js build output and cache
sorento_crm_frontend/.next/*
sorento_crm_backend/.next/*

# Local MCP server config (carries Bearer tokens / secrets — never commit)
.mcp.json

# Environment files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
# Per-slot backend envs (`.env.slot3080`, `.env.slot8080`, ...). A lane stack copies the
# real `.env` per port slot, so these carry the same live secrets `.env` does and must
# never be committed - PR #735 had a push REJECTED by the secret-scanning rule after a
# `git add -A` swept one in. The exact-name entries above do not cover the shape.
.env.slot*

# Private test-DB env (`SORENTO_ENV_FILE=.env.ci-tests`, see CLAUDE.md) - carries a DB
# password and was not matched by any rule above (review, round 2).
.env.ci-tests

# Playwright MCP scratch (console logs, page snapshots)
.playwright-mcp/

# Raw captures carry auth headers, prod-copy pages or queue payloads; the repo
# is public (scripts/pii_guard.py fails CI on them too).
*.har
*.rdb
.cursor/debug.log
# Root-level page snapshots from browser tools (none is a real config file).
/*.yml

# Claude-managed dev server logs
.devlogs/

# Lavish review artifacts (regenerated from the plan docs)
.lavish/

# Agent browser-verification evidence (screenshots, snapshots)
.evidence/

# OS files
.DS_Store

# Compressed files
*.gz
*.old
*.pack
*.pyc
*.pyo
__pycache__/

docker-compose.yml
/*.png

# Private keys (security audit 2026-06-29 — never commit)
*.pem
private_key.pem

# lavish artifact output (local only)
.lavish/

# Session resume documents written by /handoff. Transit, not artifacts - they must
# never land in a feature PR diff. The README documents the convention and stays.
.claude/handoffs/*
!.claude/handoffs/README.md

# Claude Code runtime state. scheduled_tasks.lock is a per-process lock
# ({sessionId, pid, acquiredAt}) rewritten by every session, so it shows as
# modified in every checkout; settings.local.json is per-machine permission
# overrides. Neither is project config - .claude/settings.json, skills/,
# agents/, commands/ stay tracked.
.claude/scheduled_tasks.lock
.claude/settings.local.json

# Pre-trial snapshot written by scripts/container_status_trial.py - holds live
# clearance data, and is per-environment. Keep it on the box, out of the repo.
sorento_crm_backend/scripts/container_status_trial_snapshot.json

# Operator-script backup/preview JSON (e.g. dedupe_spo_number_format.py). Per-run,
# per-environment, holds full row dumps - never shipped.
sorento_crm_backend/scripts/out/

# Session handoff artifacts are machine-local, never shipped
/HANDOFF-*.md

# Repo-root node caches and e2e stack scratch
/node_modules/
.e2e-stack/

# CI-only: buildkit-cache-dance's extracted .next/cache mount (github.workspace
# path, so it lands at the repo root of the CI checkout - never present locally)
.buildkit-cache/

# Editable-install metadata, regenerated by `pip install -e .` in the MCP package.
# It was committed by accident on this lane and is per-machine, never shipped.
sorento_crm_mcp/*.egg-info/
.env.*.bak

# per-lane private test DB env, never committed
.env.ci-tests

# Local compose overrides, key files and env variants may carry secrets; only the
# .env.example templates are tracked.
docker-compose.override*
compose.override*
*.key
.env.*
!.env.example
!**/.env.example
!sorento_crm_backend/.env.browse
